PORT=4000
NODE_ENV=development

# MySQL Database Configuration
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/omniflow_erp_db"

# Direct Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=omniflow_erp_db

# JWT Authentication
JWT_SECRET="omniflow-enterprise-ultra-secure-secret-key-2026"
JWT_EXPIRES_IN="7d"

# App Configuration
APP_NAME="OmniFlow ERP"
APP_URL="http://localhost:4000"
CORS_ORIGIN="*"

# AI & Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Notification Drivers (log | smtp | twilio)
MAIL_DRIVER=log
MAIL_FROM=no-reply@omniflow.local
SMS_DRIVER=log

# Logging (debug | info | warn | error)
LOG_LEVEL=debug
