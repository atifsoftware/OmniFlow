# ==========================================
# OmniFlow ERP - Environment Configuration
# ==========================================

# Server Configuration
PORT=4000
NODE_ENV=development
APP_NAME="OmniFlow ERP"
APP_URL="http://localhost:4000"
CORS_ORIGIN="http://localhost:3000"

# Database Configuration (MySQL / MariaDB)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://omniflow_user:omniflow_secret@localhost:3306/omniflow_erp_db"
DB_HOST=localhost
DB_PORT=3306
DB_USER=omniflow_user
DB_PASS=omniflow_secret
DB_NAME=omniflow_erp_db

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# JWT Authentication
JWT_SECRET="replace-with-a-secure-random-secret-key-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# AI Service (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Mail Driver Configuration (log | smtp)
MAIL_DRIVER=log
MAIL_FROM=no-reply@omniflow.local
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=

# SMS Driver Configuration (log | twilio)
SMS_DRIVER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Logging Level (debug | info | warn | error)
LOG_LEVEL=debug
